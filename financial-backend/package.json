  "type": "module",
  "scripts": {
    "dev": "prisma generate && prisma db push && tsx prisma/seed.ts && tsx src/index.ts",
    "prebuild": "prisma generate",
    "build": "tsc -b",
    "start": "node ./dist/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v"
  },
  "dependencies": {
    "express": "^5.1.0",
    "@prisma/client": "^7.0.0",
    "@prisma/adapter-pg": "^7.0.0",
    "pg": "^8.13.0",
    "zod": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express-rate-limit": "^7.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/pg": "^8.11.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "prisma": "^7.0.0"
  }
}
